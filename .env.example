# =====================================================================
# E-Commerce Order Management & Search Service — environment template
# Copy to `.env` and adjust values. NEVER commit real secrets.
#
# Default values below assume local development ON THE HOST (localhost).
# docker-compose.yml overrides the *_HOST / *_URL entries with the
# in-network service names when running inside containers.
# =====================================================================

# ------------------------- Application ------------------------------
APP_NAME="E-Commerce Order Management & Search Service"
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------- Spring Boot API --------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------- PostgreSQL --------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=ecommerce
POSTGRES_SSLMODE=disable
POSTGRES_POOL_SIZE=5

# ------------------------- MongoDB -----------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=catalog
MONGO_TIMEOUT_MS=5000

# ------------------------- Elasticsearch -----------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=orders
# Leave empty for a local single-node cluster with security disabled
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_TIMEOUT=10
# Refresh the document immediately after indexing so the demo can search a
# just-placed order without waiting for an Elasticsearch refresh cycle.
ELASTICSEARCH_REFRESH_ON_WRITE=true

# ------------------------- RabbitMQ ----------------------------------
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASSWORD=change_me_rabbit
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Built from the values above unless explicitly overridden
RABBITMQ_URL=amqp://ecommerce:change_me_rabbit@localhost:5672//

# ------------------------- RabbitMQ sync queue ----------------------
# Queue the backend publishes order-change messages to and the Java
# @RabbitListener consumes from. Retry/backoff lives in
# application.yml under spring.rabbitmq.listener.simple.retry.
RABBITMQ_SYNC_QUEUE=orders_sync

# ------------------------- JWT ---------------------------------------
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------- File Uploads ------------------------------
UPLOADS_DIR=/app/uploads

# ------------------------- Frontend ----------------------------------
# Base URL the browser uses to reach the API.
# The Vite dev server also proxies `/api` -> backend, so `/api` works too.
VITE_API_BASE_URL=http://localhost:8000
# Vite dev-server proxy target for relative /api calls (in-network name).
VITE_PROXY_TARGET=http://backend:8000

# ------------------------- Web (nginx) -------------------------------
WEB_PORT=8080

# ------------------------- Elasticsearch (JVM) -----------------------
ES_JAVA_OPTS=-Xms512m -Xmx512m